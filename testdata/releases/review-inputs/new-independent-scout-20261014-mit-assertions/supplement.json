      "source_file": "test/parse/video.test.ts",
      "source_index": 0,
      "input": "Treasure.Island.1999.FULLSCREEN.2003.RERELEASE.NTSC.USA.DVD9-AndreMor",
      "title": "Treasure Island",
      "input_line": 228,
      "title_line": 230,
      "original_assertion_block": "const result = parseVideo('movies', 'Treasure.Island.1999.FULLSCREEN.2003.RERELEASE.NTSC.USA.DVD9-AndreMor');\n  if (!result.ok) throw new Error(`refused: ${result.refusal}`);\n  assert.equal(result.parsed.title, 'Treasure Island');\n  assert.equal(result.parsed.year, 1999, 'the first year, not the re-release year');\n  assert.deepEqual(result.parsed.edition, ['FULLSCREEN', 'RERELEASE']);\n  assert.equal(result.parsed.group, 'AndreMor');",
      "oracle_kind": "direct-node-real-movie-title-equality",
      "source_id": "walker-media-name-parser-extra",
      "review_status": "unreviewed",
      "accepted": false,
      "authority": false,
