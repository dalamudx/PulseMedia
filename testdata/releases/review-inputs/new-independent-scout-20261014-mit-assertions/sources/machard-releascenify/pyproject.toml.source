[build-system]
requires = ["setuptools>=61.0.0", "wheel", "setuptools-scm>=6.2"]
build-backend = "setuptools.build_meta"

[project]
name = "releascenify"
dynamic = ["version"]
description = "A regex-based Python library to parse scene release names and extract technical metadata"
readme = "README.md"
requires-python = ">=3.7"
license = { file = "LICENSE" }
classifiers = [
    "Programming Language :: Python :: 3",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
]
dependencies = []

[project.optional-dependencies]
dev = [
    "pytest>=7.0.0",
]

[tool.setuptools]
packages = ["releascenify"]

[tool.setuptools_scm]
write_to = "releascenify/_version.py"
