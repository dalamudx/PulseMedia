{
  "name": "media-name-parser",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.local --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:deploy": "node node_modules/drizzle-kit/bin.cjs migrate",
    "corpus": "node --import tsx scripts/corpus-report.ts",
    "seed:key": "node --env-file=.env.local --import tsx scripts/seed-api-key.ts",
    "admin:promote": "node --env-file=.env.local --import tsx scripts/promote-admin.ts",
    "backfill:versions": "node --env-file=.env.local --import tsx scripts/backfill-media-versions.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@scalar/nextjs-api-reference": "^0.11.17",
    "@vercel/functions": "^3.9.5",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.80.0",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
